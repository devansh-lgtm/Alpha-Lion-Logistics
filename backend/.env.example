# Server
PORT=5000
NODE_ENV=development

# Comma-separated list of allowed browser origins (your frontend URLs)
CORS_ORIGINS=http://localhost:5173,https://www.alphalionlogistics.com

# Where every form submission is delivered (your company inbox)
COMPANY_EMAIL=quotes@alphalionlogistics.com
COMPANY_NAME=Alpha Lion Logistics

# SMTP credentials (works with Google Workspace / Gmail app passwords, Office 365, SendGrid, Mailgun, Zoho, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=quotes@alphalionlogistics.com
SMTP_PASS=your-app-password-here

# "From" address shown on outgoing mail (usually the same as SMTP_USER)
MAIL_FROM="Alpha Lion Logistics Website <quotes@alphalionlogistics.com>"
